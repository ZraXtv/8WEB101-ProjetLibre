# Réglages propres à chaque machine. Copier ce fichier en « .env » et le
# remplir : .env n'est jamais commité (il contient le mot de passe admin).

# Compte superutilisateur du tableau de bord (http://127.0.0.1:8090/_/).
# Créé ou mis à jour à chaque démarrage. Laisser vide pour le créer à la
# main depuis le lien affiché au premier lancement.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Adresse d'écoute. En local : 127.0.0.1:8090. Dans Docker ou sur un
# serveur : 0.0.0.0:8090 (derrière un proxy HTTPS).
PB_HTTP=127.0.0.1:8090

# Sites autorisés à appeler l'API depuis un autre domaine (CORS), séparés par
# des virgules. Vide = réglage par défaut de PocketBase (tous les sites) : sans
# grand risque ici, la connexion passant par un jeton et non par un cookie.
# À restreindre en production, par exemple pour GitHub Pages :
# PB_ORIGINS=https://zraxtv.github.io
PB_ORIGINS=
